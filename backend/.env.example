# backend/.env.example
# Copy to .env and fill in real values:  cp .env.example .env

PORT=5000
NODE_ENV=development

MONGO_URL=mongodb://localhost:27017/taskwork
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32  (at least 32 characters)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
COOKIE_SECRET=change-me-cookie-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# fake = no real uploads , cloudinary = real uploads
STORAGE_DRIVER=fake
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=